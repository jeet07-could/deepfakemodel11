# Inference backend only. Set these in the backend host's secret environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_REGION=ap-south-1
XDFDET_CORS_ORIGINS=https://your-app.vercel.app

# Public frontend build settings. SUPABASE_ANON_KEY is designed to be public;
# never put SUPABASE_SERVICE_ROLE_KEY in Vercel or frontend configuration.
XDFDET_API_URL=https://your-api.example.com
SUPABASE_ANON_KEY=replace-with-public-anon-key
